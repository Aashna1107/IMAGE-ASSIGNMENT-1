from google.colab import files
from PIL import Image
import numpy as np
import matplotlib.pyplot as plt

# Upload RGB image
uploaded = files.upload()
img = Image.open(next(iter(uploaded))).convert("RGB")

# Convert image to array
I = np.array(img)
R, G, B = I[:,:,0], I[:,:,1], I[:,:,2]

# Case 1: Mean average of R, G, B
gray1 = (R + G + B) / 3

# Case 2: Weighted average
wR = float(input("Enter weight for R: "))
wG = float(input("Enter weight for G: "))
wB = float(input("Enter weight for B: "))

gray2 = wR*R + wG*G + wB*B

# Display
plt.figure(figsize=(10,4))

plt.subplot(1,3,1)
plt.imshow(img)
plt.title("Original RGB")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(gray1, cmap="gray")
plt.title("Case 1: Mean")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(gray2, cmap="gray")
plt.title("Case 2: Weighted")
plt.axis("off")

plt.show()
